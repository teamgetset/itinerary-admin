# GETSET admin. Copy to .env.local for development. All values are server-only.

# The GETSET API (getset-itinerary-backend). The browser never calls it directly:
# the admin's server does, with the signed-in user's session token.
API_URL=http://localhost:4000

# The customer website, for "View on site" links.
SITE_URL=http://localhost:3000
